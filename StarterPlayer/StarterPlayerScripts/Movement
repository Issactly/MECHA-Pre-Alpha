local isCtrlHeld = false
local isCrouching = false

local isSliding = false

--State Machine
local States = {
	IDLE = "Idle",
	WALKING ="Walking",
	RUNNING = "Running",
	BACKWARDS = "Backwards",
	CROUCHING = "Crouching",
	SLIDING = "Sliding"
}
local currentState = States.IDLE

--stop animations
local function StopAllAnims()
	--forwards
	ForwardsRunTrack:Stop()
	ForwardsWalkTrack:Stop()
	ForwardsCrouchTrack:Stop()
	ForwardsJumpTrack:Stop()
	--backwards
	BackwardsRunTrack:Stop()
	BackwardsWalkTrack:Stop()
	BackwardsCrouchTrack:Stop()
	BackwardsJumpTrack:Stop()
	--left
	LeftRunTrack:Stop()
	LeftWalkTrack:Stop()
	LeftCrouchTrack:Stop()
	LeftJumpTrack:Stop()
	--right
	RightRunTrack:Stop()
	RightWalkTrack:Stop()
	RightCrouchTrack:Stop()
	RightJumpTrack:Stop()
	--idles
	CrouchIdleTrack:Stop()
	StandIdleTrack:Stop()
	SlideDirectionalTrack:Stop()
end

--main state setter
local function SetState(newState)
	StopAllAnims()
	currentState = newState
	
	if newState == States.IDLE then
		if isCrouching then
			hum.WalkSpeed = 7
		else
		hum.WalkSpeed = 0
			StandIdleTrack:Play()
			end
	elseif newState == States.WALKING then
		hum.WalkSpeed = 16
		if isMovingForwards then
			ForwardsWalkTrack:Play()
		elseif isMovingLeft then
			LeftWalkTrack:Play()
		elseif isMovingRight then
			RightWalkTrack:Play()
		end
	elseif newState == States.RUNNING then
		hum.WalkSpeed = 35
		if isMovingForwards then
			ForwardsRunTrack:Play()
		elseif isMovingLeft then
			LeftRunTrack:Play()
		elseif isMovingRight then
			RightRunTrack:Play()
		end
	elseif newState == States.BACKWARDS then
		if isShiftHeld then
			hum.WalkSpeed = 20
			BackwardsRunTrack:Play()
		else
			hum.WalkSpeed = 14
			BackwardsWalkTrack:Play()
		end
	elseif newState == States.CROUCHING then
		hum.WalkSpeed = 7
		if isMovingForwards then
			ForwardsCrouchTrack:Play()
		elseif isMovingBackwards then
			BackwardsCrouchTrack:Play()
		elseif isMovingLeft then
			LeftCrouchTrack:Play()
		elseif isMovingRight then
			RightCrouchTrack:Play()
		else
			CrouchIdleTrack:Play()
		end
	elseif newState == States.SLIDING then
		hum.WalkSpeed = 0
		SlideDirectionalTrack:Play()
	end
end

-- choose state on input
local function UpdateState()
	if isSliding then
		SetState(States.SLIDING)
		print('SLIDING')
	elseif isCrouching then
		SetState(States.CROUCHING)
		print('CROUCHING')
	elseif isMovingBackwards then
		SetState(States.BACKWARDS)
		print('BACKWARDS')
	elseif isMovingForwards or isMovingLeft or isMovingRight then
		if isShiftHeld then
			SetState(States.RUNNING)
			print('RUNNING')
	else
			SetState(States.WALKING)
			print('WALKING')
		end
	else
		SetState(States.IDLE)
		print('IDLE')
	end
end

--begin input
UIS.InputBegan:Connect(function(input, gameProcessed)
	if _G.PODUIOPEN then return end
	if input.KeyCode == Enum.KeyCode.W then
		isMovingForwards =true
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.A then
		isMovingLeft = true
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.S then
		isMovingBackwards = true
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.D then
		isMovingRight = true
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		isShiftHeld = true
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		if isSliding then
			return
		else
			isCtrlHeld = true
			isCrouching = true
			hum.HipHeight -= 1
			--hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,false)
			UpdateState()
		end
	elseif input.KeyCode == Enum.KeyCode.X then
		if isCrouching then
			return
		end
		--if not moving then no slide momentum
		if isSliding ==  false and (isMovingForwards or isMovingLeft or isMovingRight or isMovingBackwards) then
			isSliding = true
			hum.HipHeight -= 1.2
			local velocity = Instance.new("BodyVelocity")
			velocity.MaxForce = Vector3.new(1,0,1) * 7000
			velocity.Velocity = root.CFrame.lookVector * 100
			velocity.Parent = root
			UpdateState()
			--wait for slide to end
			wait(1)
			velocity:Destroy()
			hum.HipHeight += 1.2
			isSliding = false
			UpdateState()
		end
	end
end)

--end input
UIS.InputEnded:Connect(function(input, gameProcessed)
	if _G.PODUIOPEN then return end
	if input.KeyCode == Enum.KeyCode.W then
		isMovingForwards = false
		UpdateState()
	elseif input .KeyCode == Enum.KeyCode.A then
		isMovingLeft = false
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.S then
		isMovingBackwards = false
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.D then
		isMovingRight = false
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.LeftShift then
		isShiftHeld = false
		UpdateState()
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		if isSliding then
			return
		elseif isCrouching == true then
		isCtrlHeld = false
		isCrouching = false
		hum.HipHeight += 1
		--hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,true)
		UpdateState()
		end
	end
end)
